{
  "name": "tournament-streaming",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-camera tournament streaming and recording system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tournament/dashboard",
    "dev:node": "npm run dev --workspace=@tournament/node-service",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace=@tournament/dashboard",
    "check:core": "node scripts/core-check.mjs",
    "check:api": "node scripts/api-smoke.mjs",
    "check:baseline": "npm run check:core && npm run typecheck && npm run build",
    "test:core": "node --import tsx --test tests/core-integration.test.mts",
    "check:integration": "npm run typecheck && npm run test:core && npm run test:lifecycle && npm run test:relay && npm run test:youtube-readiness && npm run test:preflight && npm run test:live-check",
    "test:lifecycle": "node --import tsx --test tests/core-lifecycle.test.mts",
    "test:hardware": "node --import tsx scripts/hardware-smoke.mts",
    "test:relay": "node --import tsx --test tests/relay-lifecycle.test.mts",
    "test:youtube-readiness": "node --import tsx --test tests/youtube-e2e-readiness.test.mts",
    "test:preflight": "node --import tsx --test tests/relay-preflight.test.mts",
    "test:live-check": "node --import tsx --test tests/youtube-live-check.test.mts",
    "youtube:check": "node --import tsx scripts/youtube-live-check.mts",
    "test:multicam": "node --import tsx --test tests/multicam-audit.test.mts",
    "multicam:audit": "node --import tsx scripts/multicam-audit.mts",
    "test:capture-growth": "node --import tsx --test tests/capture-growth.test.mts",
    "capture:growth": "node --import tsx scripts/capture-growth.mts",
    "test:recording-verify": "node --import tsx --test tests/recording-verify.test.mts",
    "recording:verify": "node --import tsx scripts/recording-verify.mts",
    "recording:deep": "node --import tsx scripts/recording-deep.mts",
    "test:recording-deep": "node --import tsx --test tests/recording-deep.test.mts",
    "test:all": "node scripts/run-all-tests.mjs",
    "observer:playback": "node tools/youtube-playback-observer.mjs",
    "release:check": "node tools/tournament-release-check.mjs",
    "release:workflow": "node tools/tournament-release-workflow.mjs",
    "test:browser": "npm --prefix browser-tests test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
