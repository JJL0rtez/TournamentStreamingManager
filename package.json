{
  "name": "tournament-streaming",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-camera tournament streaming and recording system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@tournament/dashboard",
    "dev:node": "npm run dev --workspace=@tournament/node-service",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace=@tournament/dashboard"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
