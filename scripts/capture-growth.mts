/** Two-snapshot, read-only multi-camera capture and recording growth audit. */
import {compare,parseIds,summarize,validateBase,type CaptureSample} from './capture-growth-lib.mts';
const args=process.argv.slice(2);const val=(flag:string)=>{const i=args.indexOf(flag);return i<0?undefined:args[i+1];};
if(args.includes('--help')){console.log('Usage: npm run capture:growth -- --cameras ID1,ID2 [--seconds 20] [--url http://127.0.0.1:3001]');process.exit(0);}
const ids=parseIds(val('--cameras')||'');if(!ids.length){console.error('Supply actual camera IDs with --cameras');process.exit(2);}
const seconds=Number(val('--seconds')??'20');if(!Number.isInteger(seconds)||seconds<1||seconds>120){console.error('--seconds must be 1..120');process.exit(2);}
let base:string;try{base=validateBase(val('--url')||process.env.TOURNAMENT_API_URL||'http://127.0.0.1:3001');}catch(e){console.error(String(e));process.exit(2);}
async function snapshot():Promise<CaptureSample[]>{const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),5000);try{const response=await fetch(base+'/api/captures',{signal:controller.signal,headers:{accept:'application/json'}});if(!response.ok)throw Error(`Capture API HTTP ${response.status}`);const data=await response.json() as {captures?:unknown};if(!Array.isArray(data.captures))throw Error('Capture API did not return a captures array');return data.captures as CaptureSample[];}finally{clearTimeout(timeout);}}
try{const first=await snapshot();await new Promise(resolve=>setTimeout(resolve,seconds*1000));const second=await snapshot();const findings=compare(first,second,ids);const summary=summarize(findings);console.log(JSON.stringify({durationSeconds:seconds,cameraIds:ids,summary,findings,notes:['Read-only API inspection','Frame progress is not a substitute for checking encoded video','Recording growth is not proof of playable MKV audio/video','YouTube ingest not verified']},null,2));if(summary.errors)process.exitCode=1;}catch(e){console.error(e instanceof Error?e.message:String(e));process.exitCode=2;}
