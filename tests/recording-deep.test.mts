import {test} from 'node:test';
import {strict as assert} from 'node:assert';
import {parseDuration,parseDb,parseFilterLog,assess,validateArgs,mapLimit} from '../scripts/recording-deep-lib.mts';
const base={file:'test.mkv',bytes:10000,duration:20,videoFrames:600,audioRmsDb:-22,audioPeakDb:-4,blackSeconds:0,freezeSeconds:0,silenceSeconds:0,decodeErrors:0,exitCode:0,timedOut:false};
const opts={minSeconds:3,maxBlackRatio:.1,maxFreezeRatio:.2,maxSilenceRatio:.8,silenceDb:-55};
test('375 parse HH:MM:SS timestamps',()=>assert.equal(parseDuration('time=00:01:02.50'),62.5));
test('376 reject invalid timestamps',()=>assert.equal(parseDuration('no timestamp'),null));
test('377 parse audio RMS',()=>assert.equal(parseDb('RMS level dB: -21.7','RMS level dB'),-21.7));
test('378 parse silent negative infinity',()=>assert.equal(parseDb('RMS level dB: -inf','RMS level dB'),-Infinity));
test('379 parse black duration',()=>assert.equal(parseFilterLog('black_start:1 black_end:3 black_duration:2').blackSeconds,2));
test('380 parse freeze duration',()=>assert.equal(parseFilterLog('freeze_start:1 freeze_end:4 freeze_duration:3').freezeSeconds,3));
test('381 parse silence duration',()=>assert.equal(parseFilterLog('silence_end: 4 | silence_duration: 2').silenceSeconds,2));
test('382 parse frame counts',()=>assert.equal(parseFilterLog('frame=  40\nframe= 100').videoFrames,100));
test('383 successful decode',()=>assert.equal(assess(base,opts).find(x=>x.code==='decode')?.level,'ok'));
test('384 detect decode errors',()=>assert.equal(assess({...base,exitCode:1},opts).find(x=>x.code==='decode')?.level,'error'));
test('385 detect timeout',()=>assert.equal(assess({...base,timedOut:true},opts).find(x=>x.code==='timeout')?.level,'error'));
test('386 detect missing video frames',()=>assert.equal(assess({...base,videoFrames:0},opts).find(x=>x.code==='video-frames')?.level,'error'));
test('387 warn missing frame count',()=>assert.equal(assess({...base,videoFrames:null},opts).find(x=>x.code==='video-frames')?.level,'warning'));
test('388 warn silent audio',()=>assert.equal(assess({...base,audioRmsDb:-Infinity},opts).find(x=>x.code==='audio-level')?.level,'warning'));
test('389 warn missing audio levels',()=>assert.equal(assess({...base,audioRmsDb:null},opts).find(x=>x.code==='audio-level')?.level,'warning'));
test('390 detect black video ratio',()=>assert.equal(assess({...base,blackSeconds:5},opts).find(x=>x.code==='black')?.level,'warning'));
test('391 tolerate brief black frames',()=>assert.equal(assess({...base,blackSeconds:.5},opts).find(x=>x.code==='black')?.level,'ok'));
test('392 detect frozen video ratio',()=>assert.equal(assess({...base,freezeSeconds:10},opts).find(x=>x.code==='freeze')?.level,'warning'));
test('393 detect excessive silence',()=>assert.equal(assess({...base,silenceSeconds:18},opts).find(x=>x.code==='silence')?.level,'warning'));
test('394 tolerate ordinary silence',()=>assert.equal(assess({...base,silenceSeconds:2},opts).find(x=>x.code==='silence')?.level,'ok'));
test('395 warn short duration',()=>assert.equal(assess({...base,duration:1},opts).find(x=>x.code==='short-duration')?.level,'warning'));
test('396 unknown duration does not divide by zero',()=>assert.equal(assess({...base,duration:null},opts).find(x=>x.code==='black')?.level,'warning'));
test('397 reject zero concurrency',()=>assert.throws(()=>validateArgs(0,10,60)));
test('398 reject more than 8 concurrent jobs',()=>assert.throws(()=>validateArgs(9,10,60)));
test('399 reject excess file count',()=>assert.throws(()=>validateArgs(2,201,60)));
test('400 reject too-short timeout',()=>assert.throws(()=>validateArgs(2,10,1)));
test('401 accept normal limits',()=>assert.doesNotThrow(()=>validateArgs(2,10,180)));
test('402 preserve result order',async()=>assert.deepEqual(await mapLimit([3,2,1],2,async x=>x*x),[9,4,1]));
test('403 handle empty job list',async()=>assert.deepEqual(await mapLimit([],2,async x=>x),[]));
test('404 audio peak level parsing',()=>assert.equal(parseFilterLog('Peak level dB: -1.2').audioPeakDb,-1.2));
test('405 report multiple black segments',()=>assert.equal(parseFilterLog('black_start:1 black_end:2 black_duration:1\nblack_start:4 black_end:6 black_duration:2').blackSeconds,3));
test('406 report multiple silence segments',()=>assert.equal(parseFilterLog('silence_end: 2 | silence_duration: 1\nsilence_end: 5 | silence_duration: 2').silenceSeconds,3));
test('407 detect borderline black threshold',()=>assert.equal(assess({...base,blackSeconds:2},opts).find(x=>x.code==='black')?.level,'ok'));
test('408 reject black above threshold',()=>assert.equal(assess({...base,blackSeconds:2.1},opts).find(x=>x.code==='black')?.level,'warning'));
test('409 retain file identity',()=>assert.equal(base.file,'test.mkv'));
test('410 decode success includes status',()=>assert.match(assess(base,opts).find(x=>x.code==='decode')!.message,/successfully/));
test('411 missing audio levels do not claim audible sound',()=>assert.notEqual(assess({...base,audioRmsDb:null},opts).find(x=>x.code==='audio-level')?.level,'ok'));
test('412 preserve decoded video frames',()=>assert.equal(assess(base,opts).find(x=>x.code==='video-frames')?.level,'ok'));
test('413 warn freeze without duration',()=>assert.equal(assess({...base,duration:null},opts).find(x=>x.code==='freeze')?.level,'warning'));
test('414 warn silence without duration',()=>assert.equal(assess({...base,duration:null},opts).find(x=>x.code==='silence')?.level,'warning'));
